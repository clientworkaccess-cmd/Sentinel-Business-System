# Copy to .env at the repo root and fill in. Never commit the real .env.

# --- Database -------------------------------------------------------------
# Neon Postgres connection string. Must include ?sslmode=require.
# Driver prefix must be postgresql+psycopg:// (psycopg 3), not postgres://.
DATABASE_CONNECTION_STRING=postgresql+psycopg://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# --- Auth -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# This key is the tenancy boundary - company_id is a signed claim.
JWT_SECRET_KEY=change-me-generate-a-real-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- App ------------------------------------------------------------------
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
# Run the background scheduler (daily chase, connector sync) in this process.
# With several API processes, set true in exactly one of them.
RUN_SCHEDULER=true

# --- Agent & LLM ----------------------------------------------------------
# Required. The Sentinel agent layer and meeting transcription both fail without it.
# Never put the real value in this file or anywhere else in the repo - .env only.
QWEN_API_KEY=
# OpenAI-compatible endpoint for the chat/agent model.
QWEN_API_BASE=https://your-workspace.region.maas.aliyuncs.com/compatible-mode/v1
AGENT_MODEL=qwen3.6-plus
# Confidence at or above which an extracted task auto-approves. 1.0 disables
# auto-approval entirely: everything waits in the founder queue.
AUTO_APPROVE_THRESHOLD_DEFAULT=1.0

# --- Connectors (Composio) ------------------------------------------------
# Composio runs the OAuth consent screens (Composio-managed apps, no custom branding)
# and holds every Google/Slack token. Sentinel stores only Composio's account ids.
# Empty = the Connect buttons return 503; everything else keeps working.
COMPOSIO_API_KEY=
# Optional: pin an existing auth config per toolkit ("ac_..."). Leave blank to have
# Sentinel find (or create) a Composio-managed one on first connect.
COMPOSIO_AUTH_CONFIG_GMAIL=
COMPOSIO_AUTH_CONFIG_GOOGLECALENDAR=
COMPOSIO_AUTH_CONFIG_GOOGLEDRIVE=
COMPOSIO_AUTH_CONFIG_SLACK=
# Browser-reachable URL of this API. Composio sends the user back to
# PUBLIC_API_URL/api/v1/connectors/callback after consent.
PUBLIC_API_URL=http://localhost:8000
# Where the callback then returns the browser (the connector gallery).
FRONTEND_URL=http://localhost:3000
# Background re-sync cadence, and how far back a first sync reaches.
CONNECTOR_SYNC_INTERVAL_MINUTES=30
CONNECTOR_BACKFILL_DAYS=90

# --- Knowledge layer (HydraDB) --------------------------------------------
# Vector memory for chat recall. Empty disables it; the graph still answers.
HYDRA_DB_API_KEY=
HYDRA_TIMEOUT_SECONDS=30
