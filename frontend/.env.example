# Copy to frontend/.env.local. Server-only: never prefix these with NEXT_PUBLIC_.
# Without them the /brain demo still works — chat serves scripted answers and voice
# falls back to the browser's own speech APIs.

# --- Chat (Qwen, OpenAI-compatible) — same names as backend/.env.example ---
QWEN_API_KEY=
QWEN_API_BASE=https://your-workspace.region.maas.aliyuncs.com/compatible-mode/v1
AGENT_MODEL=qwen3.6-plus
# 1 = always serve the tuned scripted answers for the suggested prompts (rehearsed runs).
BRAIN_CHAT_PREFER_SCRIPTED=0

# --- Voice (ElevenLabs) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_UR=
# Optional overrides
# ELEVENLABS_STT_MODEL=scribe_v1
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
